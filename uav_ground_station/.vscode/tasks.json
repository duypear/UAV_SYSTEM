{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP-IDF: Build",
            "type": "shell",
            "command": "idf.py build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "ESP-IDF: Flash",
            "type": "shell",
            "command": "idf.py flash",
            "problemMatcher": []
        },
        {
            "label": "ESP-IDF: Monitor",
            "type": "shell",
            "command": "idf.py monitor",
            "problemMatcher": []
        },
        {
            "label": "ESP-IDF: Flash & Monitor",
            "type": "shell",
            "command": "idf.py flash monitor",
            "problemMatcher": []
        },
        {
            "label": "ESP-IDF: Set Target ESP32-C3",
            "type": "shell",
            "command": "idf.py set-target esp32c3",
            "problemMatcher": []
        }
    ]
}
